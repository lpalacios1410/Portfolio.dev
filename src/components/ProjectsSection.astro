---
import react from "../icons/react.svg";
import tailwind from "../icons/tailwindcss.svg";
import nodejs from "../icons/nodejs.svg";
import javascript from "../icons/javascript.svg";
import postgresql from "../icons/postgresql.svg";
import astro from "../icons/astro.svg";
import typescript from "../icons/typescript.svg";
import nextjs from "../icons/nextjs.svg";
import CardProject, { type ProjectKeys } from "./CardProject.astro";
import type { SvgComponent } from "astro/types";
import type { ImageMetadata } from "astro";
import imgProyecto1 from "../assets/onlygirlsccs.png";
import imgProyecto2 from "../assets/Astro1.png";

type TechIcon = SvgComponent;
interface TechStackItem {
  label: string;
  icon: TechIcon;
}
interface Project {
  title: string;
  subtitle: string;
  category: string;
  description: string;
  languages: TechStackItem[];
  status: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
  urlProject: string;
  urlDemo: string;
  keys: ProjectKeys;
}

const projects: Project[] = [
  {
    title: "E-commerce onlygirlsccs",
    subtitle: "App web",
    category: "Gestión de productos",
    description:
      "Trabajo como repartidor para una tienda online en Caracas, Venezuela. También ayudé a crear un pequeño sistema para que nuestros clientes puedan ver nuestro catálogo. Esto nos permite dejar de depender de WhatsApp y ofrecer otras opciones.",
    languages: [
      { label: "React", icon: react },
      { label: "JavaScript", icon: javascript },
      { label: "Tailwind", icon: tailwind },
      { label: "NodeJs", icon: nodejs },
      { label: "PostgreSQL", icon: postgresql },
    ],
    status: "Activo",
    imageSrc: imgProyecto1,
    imageAlt: "Captura de pantalla de la tienda online OnlyGirlsCCS",
    urlProject: "https://github.com/lpalacios1410/OnlyGirlsCss-Ecommerce",
    urlDemo: "https://onlygirlsccs.vercel.app/",
    keys: {
      title: "projects.0.title",
      subtitle: "projects.0.subtitle",
      category: "projects.0.category",
      description: "projects.0.description",
      status: "projects.0.status",
    },
  },

  {
    title: "AstroTurismo",
    subtitle: "Landing Page",
    category: "Turismo",
    description:
      "Sitio web de Turismo para la agencia ficticia AstroTurismo, especializada en llevar viajeros a los cielos más oscuros del planeta (Bortle clase 1 y 2) para observar auroras boreales, lluvias de meteoros, eclipses totales y la Vía Láctea.",
    languages: [
      { label: "Astro", icon: astro },
      { label: "React", icon: react },
      { label: "Tailwind", icon: tailwind },
      { label: "TypeScript", icon: typescript },
    ],
    status: "Activo",
    imageSrc: imgProyecto2,
    imageAlt: "Captura de pantalla landing page AstroTurismo",
    urlProject: "https://github.com/lpalacios1410/AstroTurismo",
    urlDemo: "https://astro-turismo.vercel.app/",
    keys: {
      title: "projects.1.title",
      subtitle: "projects.1.subtitle",
      category: "projects.1.category",
      description: "projects.1.description",
      status: "projects.1.status",
    },
  },

  {
    title: "MecaApp",
    subtitle: "App web",
    category: "Servicios automotrices",
    description:
      "Aplicación diseñada para mecánicos, que ofrece diversos planes para facilitar la contratación de servicios. Permite a los clientes explorar y contratar servicios de mantenimiento y reparación vehicular de forma sencilla.",
    languages: [
      { label: "Next.js", icon: nextjs },
      { label: "React", icon: react },
      { label: "Tailwind", icon: tailwind },
      { label: "TypeScript", icon: typescript },
    ],
    status: "En desarrollo",
    imageSrc: "/mecaApp.jpg",
    imageAlt: "Captura de pantalla de MecaApp - Aplicación para mecánicos",
    urlProject: "https://github.com/lpalacios1410/MecaApp",
    urlDemo: "",
    keys: {
      title: "projects.2.title",
      subtitle: "projects.2.subtitle",
      category: "projects.2.category",
      description: "projects.2.description",
      status: "projects.2.status",
    },
  },
];
---

<section
  class="max-w-7xl mx-auto px-8 py-20 scroll-mt-20"
  id="projects"
  aria-labelledby="projects-heading"
>
  <div
    class="mb-16 flex flex-col gap-5 md:flex-row items-baseline justify-between"
  >
    <h2
      id="projects-heading"
      class="projects-title text-5xl font-black tracking-tighter text-on-surface"
      data-i18n="projects.heading"
      data-animate
    >
      Proyectos Destacados
    </h2>
    <div class="h-px bg-outline-variant/20 grow mx-8 hidden md:block"></div>
    <a
      class="font-label text-sm text-primary uppercase tracking-widest hover:underline decoration-2 underline-offset-8 focus:outline-none focus:ring-2 focus:ring-primary rounded-md px-2 py-1"
      href="#"
      data-i18n-aria="projects.view_all_aria"
    >
      <span data-i18n="projects.view_all">Ver todos los proyectos</span>
    </a>
  </div>
  <div
    class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start"
    role="list"
    data-i18n-aria="projects.aria_list"
  >
    {
      projects.map((project, index) => (
        <CardProject {...project} index={index} />
      ))
    }
  </div>
</section>

<script>
  import { gsap, registerGsap } from "../scripts/gsap-init";
  import { prefersReducedMotion } from "../utils/gsap-utils";

  registerGsap();

  const prefersReduced = prefersReducedMotion();

  // Initial transforms (opacity ya via CSS progressive enhancement)
  const root = document.querySelector<HTMLElement>("#projects");
  if (root) {
    gsap.set(root.querySelector(".projects-title"), { x: -50 });
    gsap.set(root.querySelectorAll(".project-card"), { y: 80, scale: 0.95 });

    if (prefersReduced) {
      gsap.set(
        [
          root.querySelector(".projects-title"),
          ...root.querySelectorAll(".project-card"),
        ],
        {
          opacity: 1,
          x: 0,
          y: 0,
          scale: 1,
        },
      );
    } else {
      gsap.to(root.querySelector(".projects-title"), {
        scrollTrigger: { trigger: root, start: "top 80%" },
        opacity: 1,
        x: 0,
        duration: 0.8,
        ease: "power3.out",
      });

      gsap.utils
        .toArray<HTMLElement>(root.querySelectorAll(".project-card"))
        .forEach((card, i) => {
          gsap.to(card, {
            scrollTrigger: {
              trigger: card,
              start: "top 90%",
              toggleActions: "play none none reverse",
            },
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.8,
            delay: i * 0.15,
            ease: "power2.out",
          });
        });
    }
  }
</script>
