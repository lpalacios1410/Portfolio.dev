---
const socialLinks = [
  {
    name: "GitHub",
    icon: "github",
    url: "https://github.com/lpalacios1410",
    label: "sidebar.github_aria",
  },
  {
    name: "LinkedIn",
    icon: "linkedin",
    url: "https://www.linkedin.com/in/luis-palacios-739b1b15a/",
    label: "sidebar.linkedin_aria",
  },
  {
    name: "Email",
    icon: "email",
    url: "https://mail.google.com/mail/?view=cm&fs=1&to=luisarmando20092009@gmail.com",
    label: "sidebar.email_aria",
  },
];
---

<div
  id="sidebar-wrapper"
  class="fixed left-4 md:left-8 top-1/2 -translate-y-1/2 z-40 hidden md:block transition-transform duration-300 ease-in-out"
>
  <aside
    class="flex flex-col gap-4 relative top-50"
    data-i18n-aria="sidebar.aria"
  >
    <div
      class="bg-black/40 backdrop-blur-md rounded-2xl p-3 flex flex-col gap-3 border border-outline-variant/30 shadow-lg relative"
      role="list"
      data-i18n-aria="sidebar.aria"
    >
      <!-- Toggle button -->
      <button
        id="sidebar-toggle"
        class="absolute -top-2.5 -right-2.5 w-6 h-6 rounded-full bg-surface-container border border-outline-variant/30 flex items-center justify-center hover:bg-primary/30 hover:border-primary/50 transition-all z-10 cursor-pointer shadow-sm"
        type="button"
        aria-label="Ocultar sidebar"
      >
        <svg
          class="w-3 h-3 text-on-surface"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path id="chevron-path" d="M15 6l-6 6 6 6"></path>
        </svg>
      </button>

      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-xl bg-surface-container hover:bg-primary/20 transition-all duration-300 group focus:outline-none focus:ring-2 focus:ring-primary"
            role="listitem"
            data-i18n-aria={link.label}
            title={link.name}
          >
            {link.icon === "github" && (
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-github"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
            )}
            {link.icon === "linkedin" && (
              <svg
                class="w-5 h-5 text-on-surface-variant group-hover:text-primary transition-colors"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M20.447 20.452h-3.557v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.369 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            )}
            {link.icon === "email" && (
              <svg
                class="w-5 h-5 text-on-surface-variant group-hover:text-primary transition-colors"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.74a2 2 0 0 1-2.06 0L2 7" />
              </svg>
            )}
          </a>
        ))
      }

      <!-- Language Toggle -->
      <div class="w-px h-4 bg-outline-variant/30 mx-auto" aria-hidden="true">
      </div>
      <button
        id="lang-toggle"
        class="lang-toggle-btn w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold tracking-wider transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary overflow-hidden relative"
        type="button"
      >
        <span
          id="lang-toggle-text"
          class="relative z-10 text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]"
          >ES</span
        >
      </button>
    </div>

    <div class="mt-4 flex flex-col items-center gap-2" aria-hidden="true">
      <div class="w-px h-16 bg-green-500"></div>
      <span
        class="text-xs font-mono text-green-500 vertical-text"
        data-i18n="sidebar.follow">SÍGUEME</span
      >
    </div>
  </aside>
</div>

<!-- Floating button to show sidebar when hidden -->
<button
  id="sidebar-show-btn"
  class="fixed left-4 md:left-8 top-1/2 -translate-y-1/2 z-40 hidden md:flex w-10 h-10 bg-black/60 backdrop-blur-md rounded-2xl border border-outline-variant/30 items-center justify-center hover:bg-primary/30 hover:border-primary/50 transition-all cursor-pointer shadow-lg"
  type="button"
  aria-label="Mostrar sidebar"
>
  <svg
    class="w-5 h-5 text-on-surface"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M9 6l6 6-6 6"></path>
  </svg>
</button>

<style>
  .vertical-text {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    letter-spacing: 0.2em;
  }

  .lang-toggle-btn[data-lang="es"] {
    background: linear-gradient(
      180deg,
      #c60b1e 0%,
      #c60b1e 25%,
      #ffc400 25%,
      #ffc400 75%,
      #c60b1e 75%,
      #c60b1e 100%
    );
  }

  .lang-toggle-btn[data-lang="en"] {
    background: linear-gradient(
      180deg,
      #b22234 0%,
      #b22234 7.69%,
      #ffffff 7.69%,
      #ffffff 15.38%,
      #b22234 15.38%,
      #b22234 23.07%,
      #ffffff 23.07%,
      #ffffff 30.76%,
      #b22234 30.76%,
      #b22234 38.45%,
      #ffffff 38.45%,
      #ffffff 46.14%,
      #b22234 46.14%,
      #b22234 53.83%,
      #ffffff 53.83%,
      #ffffff 61.52%,
      #b22234 61.52%,
      #b22234 69.21%,
      #ffffff 69.21%,
      #ffffff 76.9%,
      #b22234 76.9%,
      #b22234 84.59%,
      #ffffff 84.59%,
      #ffffff 92.28%,
      #b22234 92.28%,
      #b22234 100%
    );
    position: relative;
  }

  .lang-toggle-btn[data-lang="en"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 46.14%;
    background: #3c3b6e;
    z-index: 1;
  }
</style>

<script>
  import { initI18n, setLanguage, getCurrentLang } from "../i18n/i18n";
  import type { Lang } from "../i18n/translations";

  initI18n();

  const STORAGE_KEY = "portfolio-sidebar-collapsed";

  // Lang toggle
  const langBtnEl = document.getElementById("lang-toggle");
  const langTextEl = document.getElementById("lang-toggle-text");

  if (langBtnEl && langTextEl) {
    const langBtn: HTMLElement = langBtnEl;
    const langText: HTMLElement = langTextEl;

    function updateToggle(lang: Lang) {
      langBtn.setAttribute("data-lang", lang);
      langText.textContent = lang.toUpperCase();
      langBtn.setAttribute(
        "aria-label",
        lang === "es" ? "Switch to English" : "Cambiar idioma a español",
      );
    }

    langBtn.addEventListener("click", () => {
      const current = getCurrentLang();
      const next: Lang = current === "es" ? "en" : "es";
      setLanguage(next);
      updateToggle(next);
    });

    updateToggle(getCurrentLang());
  }

  // Sidebar toggle
  const wrapperEl = document.getElementById("sidebar-wrapper");
  const showBtnEl = document.getElementById("sidebar-show-btn");
  const toggleBtnEl = document.getElementById("sidebar-toggle");
  const chevronEl = document.getElementById("chevron-path");

  if (wrapperEl && showBtnEl && toggleBtnEl && chevronEl) {
    const wrapper: HTMLElement = wrapperEl;
    const showBtn: HTMLElement = showBtnEl;
    const toggleBtn: HTMLElement = toggleBtnEl;
    const chevron: HTMLElement = chevronEl;

    function isCollapsed(): boolean {
      return localStorage.getItem(STORAGE_KEY) === "true";
    }

    function applyState(collapsed: boolean) {
      if (collapsed) {
        wrapper.style.transform = "translateY(-50%) translateX(-120%)";
        wrapper.style.opacity = "0";
        wrapper.style.pointerEvents = "none";
        showBtn.style.display = "flex";
        chevron.setAttribute("d", "M9 6l6 6-6 6");
      } else {
        wrapper.style.transform = "translateY(-50%)";
        wrapper.style.opacity = "1";
        wrapper.style.pointerEvents = "";
        showBtn.style.display = "none";
        chevron.setAttribute("d", "M15 6l-6 6 6 6");
      }
    }

    function toggleSidebar() {
      const next = !isCollapsed();
      localStorage.setItem(STORAGE_KEY, String(next));
      applyState(next);
      toggleBtn.setAttribute(
        "aria-label",
        next ? "Mostrar sidebar" : "Ocultar sidebar",
      );
    }

    toggleBtn.addEventListener("click", toggleSidebar);
    showBtn.addEventListener("click", toggleSidebar);

    applyState(isCollapsed());
  }
</script>
