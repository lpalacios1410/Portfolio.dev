<section
  class="max-w-7xl mx-auto px-4 sm:px-8 mt-10"
  aria-label="Visualización de código"
>
  <div
    class="flex gap-2 mb-2 pt-1 overflow-x-auto"
    aria-label="Archivos mostrados"
  >
    <span
      class="px-3 sm:px-4 py-1 rounded-t-lg font-mono text-xs border-b-2 border-blue-400 bg-gray-500/20 text-blue-500 whitespace-nowrap"
    >frontend.js</span>

    <span
      class="px-3 sm:px-4 py-1 rounded-t-lg font-mono text-xs border-b-2 border-transparent bg-gray-500/20 text-green-500 whitespace-nowrap"
    >backend.py</span>

    <span
      class="hidden sm:block px-3 sm:px-4 py-1 rounded-t-lg font-mono text-xs border-b-2 border-transparent bg-gray-500/20 text-red-500 whitespace-nowrap"
    >database.sql</span>
  </div>
  <div
    class="rounded-2xl border shadow-2xl relative overflow-hidden bg-black/30 border-outline-variant"
  >
    <div class="flex gap-2 mb-4 sm:mb-6 p-3" aria-hidden="true">
      <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-red-500/40"></div>
      <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-green-500/40"></div>
      <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-blue-500/40"></div>
    </div>

    <div class="overflow-x-auto -mt-2">
      <div
        class="p-3 sm:p-6 min-w-max"
        style="background: #0d1117; border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem;"
      >
        <div
          class="font-['ui-monospace'] text-xs sm:text-sm leading-relaxed sm:leading-loose text-white/80"
        >
          <p
            class="typewriter-line relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-green-500"
          >
            <span class="line-content">
              <span class="text-blue-400">const</span>
              <span class="text-green-500">architect</span> = &#123;
            </span>
          </p>

          <p
            class="typewriter-line ml-4 sm:ml-8 relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">
              name: <span class="text-green-500">"L. Palacios"</span>,
            </span>
          </p>

          <p
            class="typewriter-line ml-4 sm:ml-8 relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">
              role: <span class="text-green-500">"Full Stack Developer"</span>,
            </span>
          </p>

          <p
            class="typewriter-line ml-4 sm:ml-8 relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">
              focus: [<span class="text-green-500">"Architecture"</span>, <span
                class="text-green-500">"Performance"</span
              >, <span class="text-green-500">"UI"</span>],
            </span>
          </p>

          <p
            class="typewriter-line ml-4 sm:ml-8 relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">
              status: <span class="text-green-500"
                >"Open for Collaboration"</span
              >
            </span>
          </p>

          <p
            class="typewriter-line relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">&#125;;</span>
          </p>

          <br />

          <p
            class="typewriter-line relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">
              <span class="text-purple-400">while</span>(architect.active)
              &#123;
            </span>
          </p>

          <p
            class="typewriter-line ml-4 sm:ml-8 relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent text-gray-500 italic"
          >
            <span class="line-content"
              >// Engineering the future of the web</span
            >
            >
          </p>

          <p
            class="typewriter-line ml-4 sm:ml-8 relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">
              architect.<span class="text-blue-400">build</span
              >(modernSolutions);
            </span>
          </p>

          <p
            class="typewriter-line relative overflow-hidden whitespace-nowrap w-0 border-r-2 border-transparent"
          >
            <span class="line-content">&#125;</span>
          </p>
        </div>

        <span
          class="absolute right-4 sm:right-10 bottom-4 sm:bottom-10 opacity-5 text-4xl sm:text-6xl font-black italic text-white select-none"
          aria-hidden="true"
        >
          DEPLOY
        </span>
      </div>
    </div>

    <style>
      /* Asegura que el texto no se ajuste a la línea siguiente mientras se escribe */
      .typewriter-line {
        display: block;
        font-family: "ui-monospace", monospace;
        will-change: width;
      }
      .line-content {
        display: inline-block;
      }
      /* El contenido se oculta solo si JS está activo (progressive enhancement) */
      .js-ready .line-content { visibility: hidden; }
    </style>
  </div>

  <script>
    import { gsap } from "gsap";
    import {
      prefersReducedMotion,
      getReducedMotionConfig,
    } from "../utils/gsap-utils";

    let masterTl: gsap.core.Timeline | null = null;

    const initTypewriterLoop = () => {
      if (masterTl) {
        masterTl.kill();
        masterTl = null;
      }
      const lines = document.querySelectorAll<HTMLElement>(".typewriter-line");
      if (!lines.length) return;

      const motionConfig = getReducedMotionConfig();
      const prefersReduced = prefersReducedMotion();

      // 1. Preparación: Medir y configurar estados iniciales
      lines.forEach((line) => {
        const content = line.querySelector<HTMLElement>(".line-content");
        if (!content) return;
        gsap.set(content, { visibility: "visible" });
        line.dataset.width = content.offsetWidth + "px";
        gsap.set(line, { width: 0, willChange: "width" });
      });

      // Si prefiere movimiento reducido, mostrar todo el código instantáneamente
      if (prefersReduced) {
        gsap.set(lines, { width: "auto", borderRightColor: "transparent" });
        gsap.set(".line-content", { visibility: "visible" });
        return;
      }

      // 2. Crear la Línea de Tiempo Principal (Timeline)
      masterTl = gsap.timeline({
        repeat: -1,
        yoyo: true,
        repeatDelay: 2,
        ...motionConfig,
      });

      // 3. Añadir animaciones para cada línea
      lines.forEach((line, index) => {
        const targetWidth = parseFloat(line.dataset.width ?? "0") || 0;

        masterTl!.to(
          line,
          {
            width: `${targetWidth}px`,
            duration: Math.max(targetWidth * 0.008, 0.3),
            ease: "none",
            onStart: () => {
              gsap.set(line, { borderRightColor: "#22c55e" });
            },
            onComplete: () => {
              if (index < lines.length - 1) {
                gsap.set(line, { borderRightColor: "transparent" });
              }
            },
          },
          0.1,
        );
      });
    };

    // Única inicialización: astro:page-load se dispara en carga inicial y navegaciones
    document.addEventListener("astro:page-load", initTypewriterLoop);
  </script>
</section>
