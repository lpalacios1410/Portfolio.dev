---
const formacion = [
  {
    titulo: "Programador Full Stack",
    escuela: "Social Oplesk",
    periodo: "2024 Agosto - 2025 Marzo",
    descripcion:
      "Recientemente completé una especialización en SocialOplesk para actualizar mis bases técnicas, lo que me permitió dar el salto al aprendizaje de manera autodidacta. Soy un desarrollador forjado en la constancia, apoyándome en referentes de la industria (como Midudev y MoureDev) para dominar las tecnologías actuales a través de la práctica intensiva y el desarrollo de proyectos propios.",
    keys: {
      title: "education.0.title",
      period: "education.0.period",
      description: "education.0.description",
    },
  },
  {
    titulo: "Desarrollador Web Full Stack, Programador",
    escuela: "4Geeks Academy Venezuela",
    periodo: "2017 Noviembre - 2018 Marzo",
    descripcion:
      "Mi trayectoria en el desarrollo de software comenzó en 2017 con una formación Full Stack en 4Geeks Academy. Este programa fue el catalizador de mi carrera, proporcionándome una base sólida en lógica de programación y permitiéndome desarrollar mi primer proyecto integral. Tras una pausa necesaria para atender asuntos personales.",
    keys: {
      title: "education.1.title",
      period: "education.1.period",
      description: "education.1.description",
    },
  },
];
---

<section
  class="formacion py-12 md:py-20 relative"
  id="formacion"
  aria-labelledby="formacion-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="mb-10 md:mb-16 text-center">
      <h2
        id="formacion-heading"
        class="text-2xl sm:text-3xl md:text-5xl font-black tracking-widest flex items-center justify-center gap-4 text-on-surface"
        data-i18n="education.heading" data-animate
      >
        # Formación Académica
      </h2>
    </div>

    <div class="relative">
      <div
        class="absolute left-4 sm:left-6 md:left-1/2 transform -translate-x-1/2 h-full w-0.5 sm:w-1 hidden sm:block bg-linear-to-b from-transparent via-gray-500/50 to-transparent"
        aria-hidden="true"
      >
      </div>

      <div role="list" data-i18n-aria="education.aria_timeline">
        {
          formacion.map((estudio, index) => (
            <div
              class={`formacion-item flex items-center relative mb-8 md:mb-12 ${index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"}`}
              role="listitem" data-animate
            >
              <div class="hidden md:block md:w-5/12">
                <div class="formacion-card bg-gray-500/10 rounded-2xl p-4 sm:p-6 border border-outline-variant hover:border-primary/30 transition-all duration-300 text-left hover:scale-[1.02] focus-within:ring-2 focus-within:ring-primary">
                  <time
                    class="font-mono text-xs sm:text-sm text-green-500"
                    datetime={estudio.periodo}
                    data-i18n-lang={estudio.keys.period}
                  >
                    {estudio.periodo}
                  </time>
                  <h3 class="text-lg sm:text-xl font-bold mt-2 text-on-surface" data-i18n-lang={estudio.keys.title}>
                    {estudio.titulo}
                  </h3>
                  <p class="mt-1 text-green-500 text-sm">{estudio.escuela}</p>
                  <p class="text-xs sm:text-sm mt-2 sm:mt-3 text-on-surface-variant" data-i18n-lang={estudio.keys.description}>
                    {estudio.descripcion}
                  </p>
                </div>
              </div>

              <div class="block md:hidden w-full px-2 sm:px-4">
                <div class="formacion-card bg-gray-500/10 rounded-2xl p-4 border border-outline-variant hover:border-primary/30 transition-all duration-300 hover:scale-[1.02] focus-within:ring-2 focus-within:ring-primary">
                  <time
                    class="font-mono text-xs text-green-500"
                    datetime={estudio.periodo}
                    data-i18n-lang={estudio.keys.period}
                  >
                    {estudio.periodo}
                  </time>
                  <h3 class="text-lg font-bold mt-2 text-on-surface" data-i18n-lang={estudio.keys.title}>
                    {estudio.titulo}
                  </h3>
                  <p class="mt-1 text-green-500 text-sm">{estudio.escuela}</p>
                  <p class="text-xs mt-2 text-on-surface-variant" data-i18n-lang={estudio.keys.description}>
                    {estudio.descripcion}
                  </p>
                </div>
              </div>

              <div
                class="absolute left-4 sm:left-6 md:left-1/2 top-2 w-4 h-4 rounded-full bg-primary border-4 border-surface-container transform -translate-x-1/2 z-10 hidden sm:block"
                aria-hidden="true"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, registerGsap } from "../scripts/gsap-init";
  import { prefersReducedMotion } from "../utils/gsap-utils";

  registerGsap();

  const prefersReduced = prefersReducedMotion();
  const root = document.querySelector<HTMLElement>("#formacion");

  if (root) {
    const heading = root.querySelector("h2") as HTMLElement | null;
    const items = gsap.utils.toArray<HTMLElement>(root.querySelectorAll(".formacion-item"));

    items.forEach((item, i) => gsap.set(item, { x: i % 2 === 0 ? -100 : 100 }));

    if (prefersReduced) {
      gsap.set([heading, ...items], { opacity: 1, x: 0, y: 0 });
    } else {
      gsap.set(heading, { y: -50 });
      gsap.to(heading, {
        scrollTrigger: { trigger: root, start: "top 80%" },
        opacity: 1, y: 0, duration: 0.8, ease: "power3.out",
      });

      items.forEach((item, i) => {
        gsap.to(item, {
          opacity: 1, x: 0,
          duration: 1, delay: i * 0.2, ease: "power3.out",
          scrollTrigger: {
            trigger: item,
            start: "top 85%",
            toggleActions: "play none none reverse",
          },
        });
      });
    }
  }
</script>
