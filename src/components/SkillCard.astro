---
import { Icon } from "astro-icon/components";

export interface IconItem {
  name: string;
  label: string;
}

export interface Props {
  title?: string;
  titleKey?: string;
  accent: string;
  icons: IconItem[];
}

const { titleKey, accent, icons } = Astro.props;
const resolvedTitle = titleKey ?? "";
---

<div
  class="cardSkill relative overflow-hidden rounded-2xl border border-white/10 bg-surface-container focus-within:ring-2 focus-within:ring-primary"
  style={`--accent: ${accent}`}
  role="listitem"
  tabindex="0"
  data-i18n-aria="skills.aria_card"
>
  <div class="bg-black/40">
    <div class="flex items-center gap-8 p-2 border-b mb-3 border-white/10">
      <div class="flex gap-2" aria-hidden="true">
        <div class="traffic-light w-3 h-3 rounded-full bg-red-500"></div>
        <div class="traffic-light w-3 h-3 rounded-full bg-yellow-500"></div>
        <div class="traffic-light w-3 h-3 rounded-full bg-green-500"></div>
      </div>
      <h4
        class="font-label text-lg font-bold tracking-tight w-1/2 text-center"
        style="color: var(--accent)"
      >
        <span data-skill-title data-i18n={resolvedTitle}>{resolvedTitle}</span><span
          class="terminal-cursor"
          aria-hidden="true">▌</span
        >
      </h4>
    </div>
  </div>
  <div
    class="grid grid-cols-2 xs:grid-cols-3 gap-4 p-4"
    role="list"
    aria-label={`Lista de tecnologías ${resolvedTitle}`}
  >
    {
      icons.map((icon) => (
        <div
          class="skill-icon flex items-center justify-center flex-col font-bold cursor-pointer rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
          role="listitem"
          tabindex="0"
          aria-label={icon.label}
          data-skill-icon
        >
          <Icon
            name={icon.name}
            class="w-12 h-12 md:w-15 md:h-15"
            aria-hidden="true"
          />
          <span class="text-sm mt-1 text-on-surface-variant">{icon.label}</span>
        </div>
      ))
    }
  </div>
  <div class="skill-spotlight" aria-hidden="true"></div>
</div>

<style is:global>
  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes skill-border-spin {
    to {
      --angle: 360deg;
    }
  }

  @keyframes skill-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .cardSkill::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--angle, 0deg),
      transparent 0deg,
      var(--accent) 60deg,
      transparent 130deg,
      transparent 180deg,
      color-mix(in oklab, var(--accent) 65%, white) 250deg,
      transparent 310deg
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    animation: skill-border-spin 6s linear infinite;
    animation-play-state: paused;
    pointer-events: none;
  }

  .cardSkill:hover::before,
  .cardSkill:focus-within::before {
    opacity: 0.55;
    animation-play-state: running;
  }

  .skill-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in oklab, var(--accent) 14%, transparent),
      transparent 65%
    );
  }

  .cardSkill:hover .skill-spotlight,
  .cardSkill:focus-within .skill-spotlight {
    opacity: 1;
  }

  .terminal-cursor {
    display: inline-block;
    margin-left: 0.15rem;
    animation: skill-cursor-blink 1.1s step-end infinite;
  }

  .traffic-light {
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .cardSkill:hover .traffic-light {
    opacity: 1;
  }

  .skill-icon {
    opacity: 0.75;
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  .skill-icon:hover,
  .skill-icon:focus-visible {
    opacity: 1;
    filter: drop-shadow(0 0 10px color-mix(in oklab, var(--accent) 55%, transparent));
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  import {
    initCardInteractions,
    type CardInteractions,
  } from "../utils/cardInteractions";
  import { prefersReducedMotion } from "../utils/gsap-utils";

  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  const prefersReduced = prefersReducedMotion();

  let tweens: gsap.core.Tween[] = [];
  let interactions: CardInteractions[] = [];

  const initSkillCards = () => {
    tweens.forEach((tween) => {
      tween.scrollTrigger?.kill();
      tween.kill();
    });
    tweens = [];
    interactions.forEach((interaction) => interaction.destroy());
    interactions = [];

    gsap.utils.toArray<HTMLElement>(".cardSkill").forEach((card, index) => {
      const icons = card.querySelectorAll<HTMLElement>("[data-skill-icon]");
      const title = card.querySelector<HTMLElement>("[data-skill-title]");
      const entranceDelay = index * 0.15 + 0.2;

      if (!prefersReduced && icons.length > 0) {
        const tween = gsap.fromTo(
          icons,
          { opacity: 0, scale: 0.4, y: 14 },
          {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.5,
            ease: "back.out(2)",
            stagger: 0.05,
            delay: entranceDelay,
            scrollTrigger: {
              trigger: card,
              start: "top 90%",
              toggleActions: "play none none reverse",
            },
            onComplete: () => {
              gsap.set(icons, { clearProps: "transform" });
            },
          }
        );
        tweens.push(tween);
      }

      if (!prefersReduced && title) {
        const tween = gsap.to(title, {
          duration: 1,
          ease: "none",
          delay: entranceDelay + 0.1,
          scrambleText: {
            text: "{original}",
            chars: "upperCase",
            speed: 1.1,
            revealDelay: 0.2,
          },
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            once: true,
          },
        });
        tweens.push(tween);
      }

      interactions.push(initCardInteractions(card));
    });
  };

  initSkillCards();
  document.addEventListener("astro:page-load", initSkillCards);
</script>
