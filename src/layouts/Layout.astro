---
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";

const {
  title = "Luis.Dev",
  description = "Portfolio de Luis Palacios - Desarrollador Full-Stack Jr especializado en soluciones digitales",
} = Astro.props;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://portfolio-dev-nine-phi.vercel.app/",
);
const imageURL = new URL("/dev.jpg", Astro.url);
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <script is:inline>
      (function() {
        var lang = localStorage.getItem("portfolio-lang");
        if (lang === "en" || lang === "es") {
          document.documentElement.lang = lang;
        }
        document.documentElement.classList.add("js-ready");
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} data-i18n-meta-description="layout.description" />
    <meta
      name="keywords"
      content="portfolio, proyectos, desarrollo web, full-stack, JavaScript, React, Astro, Tailwind CSS, Node.js"
    />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
  </head>
  <body>
    <SocialSidebar />
    <a href="#home" class="skip-link" data-i18n="layout.skip">Saltar al contenido principal</a>
    <slot />
  </body>
</html>

<style>
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
    color-scheme: dark light;
    overflow-x: hidden;
    width: 100%;
  }
  body {
    margin:0;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
  }
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: 0.75rem 1.5rem;
    border-radius: 0 0 0.5rem 0.5rem;
    font-weight: bold;
    z-index: 100;
    transition: top 0.3s ease;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
